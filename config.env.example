# Copy to %ProgramData%\JenkinsDeployTool\config.env and fill locally.
# Do not commit real configuration or credentials.
JENKINS_URL=https://jenkins.example.com/
JENKINS_USERNAME=your-jenkins-user
JENKINS_PASSWORD=your-jenkins-token-or-password

# Optional short-lived Agent enrollment credentials.
# ENROLLMENT_USERNAME=your-enrollment-user
# ENROLLMENT_TOKEN=your-short-lived-token

# Gerrit is configured with process environment variables:
# GERRIT_URL, GERRIT_USERNAME, GERRIT_PASSWORD (see README.md).
